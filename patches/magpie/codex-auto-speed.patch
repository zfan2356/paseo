+				tierIDs = append(tierIDs, tier.ID)
+			}
+			if !reflect.DeepEqual(tierIDs, []string{"priority", "ultrafast"}) {
+				t.Fatalf("auto catalog tiers %v", tierIDs)
+			}
+			s := New()
+			to, _ := url.Parse(codex.URL)
+			s.client = &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+				if r.URL.Host == "chatgpt.com" {
+					r.URL.Scheme, r.URL.Host = to.Scheme, to.Host
+				}
+				return http.DefaultTransport.RoundTrip(r)
+			})}
+			r := postFrom(t, s, "codex", "/v1/responses", `{"model":"auto/gpt-6-luna","input":"hello-`+tt.name+`","service_tier":"ultrafast"}`)
+			if !reflect.DeepEqual(tried, tt.want) {
+				b, _ := json.Marshal(r)
+				t.Fatalf("tries %v, want %v; route %s", tried, tt.want, b)
+			}
+		})
+	}
+}
