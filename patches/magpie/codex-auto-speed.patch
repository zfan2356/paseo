+++ b/internal/gateway/auto_speed.go
@@ -0,0 +1,29 @@
+package gateway
+
+import (
+	"slices"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// autoTierBody fits the requested speed to the current attempt, not the route.
+func autoTierBody(from provider.Protocol, body []byte, tiers []string) []byte {
+	if from != provider.Chat && from != provider.Responses {
+		return body
+	}
+	switch askedTier(body) {
+	case "ultrafast":
+		if slices.Contains(tiers, "ultrafast") {
+			return body
+		}
+		if slices.Contains(tiers, "priority") {
+			return withFields(body, map[string]any{"service_tier": "priority"})
+		}
+		return withoutFields(body, "service_tier")
+	case "priority":
+		if !slices.Contains(tiers, "priority") {
+			return withoutFields(body, "service_tier")
+		}
+	}
+	return body
+}
