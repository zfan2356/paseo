+			g := provider.Group{ID: provider.AutoGroupID("gpt-6-luna"), Name: "Auto", Members: []string{"codex/gpt-6-luna", "ichat/gpt-6-luna"}, Routing: provider.Ordered, Affinity: provider.AffinitySession}
+			if err := provider.SaveGroup(g); err != nil {
