@@ -0,0 +1,100 @@
+package agent
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+
+	"github.com/yetone/magpie/internal/codexcat"
+	"github.com/yetone/magpie/internal/edit"
+	"github.com/yetone/magpie/internal/provider"
+)
+
+func paseoAutoTierCatalog(raw []byte, updates map[string]json.RawMessage) ([]byte, error) {
+	var doc map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &doc); err != nil || doc == nil {
+		return nil, errors.New("invalid catalog")
+	}
+	var models []json.RawMessage
+	if err := json.Unmarshal(doc["models"], &models); err != nil || models == nil {
+		return nil, errors.New("invalid catalog models")
+	}
+	changed := false
+	for i, entry := range models {
+		var model map[string]json.RawMessage
+		if err := json.Unmarshal(entry, &model); err != nil || model == nil {
+			return nil, errors.New("invalid catalog model")
+		}
+		var slug string
+		if err := json.Unmarshal(model["slug"], &slug); err != nil {
+			return nil, errors.New("invalid catalog slug")
+		}
+		next, ok := updates[slug]
+		if !ok {
+			continue
+		}
+		var oldTiers, newTiers any
+		if err := json.Unmarshal(next, &newTiers); err != nil {
+			return nil, errors.New("invalid replacement tiers")
+		}
+		_ = json.Unmarshal(model["service_tiers"], &oldTiers)
+		if reflect.DeepEqual(oldTiers, newTiers) {
+			continue
+		}
+		model["service_tiers"] = next
+		models[i], _ = json.Marshal(model)
+		changed = true
+	}
+	if !changed {
+		return raw, nil
+	}
+	doc["models"], _ = json.Marshal(models)
+	out, err := json.MarshalIndent(doc, "", "  ")
+	return append(out, '\n'), err
+}
+
+// Only an explicitly configured catalog is managed; its models stay untouched.
+func syncPaseoAutoTiers() error {
+	path := os.Getenv("PASEO_CODEX_SPEED_CATALOG")
+	if path == "" {
+		return nil
+	}
+	if !filepath.IsAbs(path) {
+		return errors.New("catalog path must be absolute")
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return errors.New("catalog could not be read")
+	}
+	shown, _ := provider.CatalogFor("codex")
+	byID := codexcat.ServiceTiers(provider.CodexCatalog(shown))
+	updates := map[string]json.RawMessage{}
+	for _, e := range shown {
+		if !strings.HasPrefix(e.ID, provider.AutoPrefix) {
+			continue
+		}
+		g, _, ok := provider.FindGroup(e.ID)
+		if !ok || !provider.IsCodexIchatAuto(e.ID, g) {
+			continue
+		}
+		tiers := byID[e.ID]
+		if tiers == nil {
+			updates[e.ID] = json.RawMessage(`[]`)
+		} else {
+			updates[e.ID], _ = json.Marshal(tiers)
+		}
+	}
+	out, err := paseoAutoTierCatalog(raw, updates)
+	if err != nil || bytes.Equal(raw, out) {
+		return err
+	}
+	now, err := os.ReadFile(path)
+	if err != nil || !bytes.Equal(raw, now) {
+		return errors.New("catalog changed during sync")
+	}
+	return edit.WriteAtomic(path, out)
+}
