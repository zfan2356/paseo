diff --git a/internal/provider/auto_speed.go b/internal/provider/auto_speed.go
new file mode 100644
index 0000000..bbbb9f0
--- /dev/null
+++ b/internal/provider/auto_speed.go
@@ -0,0 +1,69 @@
+package provider
+
+import (
+	"slices"
+	"strings"
+)
+
+// IsCodexIchatAuto limits this policy to a same-model personal/iChat pair.
+func IsCodexIchatAuto(ref string, g Group) bool {
+	if ref == GroupPrefix+g.ID {
+		ref = g.Ref()
+	}
+	model, ok := strings.CutPrefix(ref, AutoPrefix)
+	return ok && model != "" && len(g.Members) == 2 &&
+		slices.Contains(g.Members, "codex/"+model) && slices.Contains(g.Members, "ichat/"+model)
+}
+
+// AutoMemberTiers uses only the selected source's own advertised tiers.
+func AutoMemberTiers(p Provider, model string) []string {
+	if p.Account != nil {
+		tiers, ok := p.Account.Tiers(model)
+		if ok {
+			return tiers
+		}
+		return nil
+	}
+	if p.IsPlugin() {
+		return PluginTiers(p, model)
+	}
+	var tiers []string
+	for _, m := range p.liveByID(model) {
+		for _, tier := range m.Tiers {
+			if !slices.Contains(tiers, tier) {
+				tiers = append(tiers, tier)
+			}
+		}
+	}
+	return tiers
+}
+
+func autoGroupTiers(ms []Member) []string {
+	fast, ultra := false, false
+	add := func(ids []string) {
+		fast = fast || slices.Contains(ids, "priority")
+		ultra = ultra || slices.Contains(ids, "ultrafast")
+	}
+	for _, mb := range ms {
+		add(AutoMemberTiers(mb.Provider, mb.Model))
+		if a := mb.Provider.Account; a != nil && a.Agent == "codex" {
+			for _, l := range Logins("codex") {
+				if !l.On || l.Paused || l.Lapsed != "" {
+					continue
+				}
+				ts, ok := (&Account{Agent: "codex", User: l.User}).Tiers(mb.Model)
+				if ok {
+					add(ts)
+				}
+			}
+		}
+	}
+	var tiers []string
+	if fast {
+		tiers = append(tiers, "priority")
+	}
+	if ultra {
+		tiers = append(tiers, "ultrafast")
+	}
+	return tiers
+}
