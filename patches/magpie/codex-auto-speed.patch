+package agent
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestPaseoAutoTierCatalogPreservesChoices(t *testing.T) {
+	raw := []byte(`{"note":"keep","models":[{"slug":"auto/gpt-a","visibility":"list","context_window":123,"service_tiers":[{"id":"priority"}]},{"slug":"ichat/gpt-a","service_tiers":[{"id":"custom"}]},{"slug":"auto/gpt-b","visibility":"hide"}]}`)
+	updates := map[string]json.RawMessage{"auto/gpt-a": json.RawMessage(`[{"id":"priority"},{"id":"ultrafast"}]`), "auto/gpt-b": json.RawMessage(`[]`), "auto/missing": json.RawMessage(`[]`)}
+	out, err := paseoAutoTierCatalog(raw, updates)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var before, after map[string]any
+	json.Unmarshal(raw, &before)
+	json.Unmarshal(out, &after)
+	mb, ma := before["models"].([]any), after["models"].([]any)
+	if after["note"] != "keep" || len(ma) != len(mb) || !reflect.DeepEqual(ma[1], mb[1]) {
+		t.Fatalf("unrelated choices changed: %s", out)
+	}
+	a := ma[0].(map[string]any)
+	if a["visibility"] != "list" || a["context_window"] != float64(123) || len(a["service_tiers"].([]any)) != 2 {
+		t.Fatalf("auto entry changed unexpectedly: %v", a)
+	}
+	again, err := paseoAutoTierCatalog(out, updates)
+	if err != nil || string(again) != string(out) {
+		t.Fatal("unchanged catalog was rewritten")
+	}
+	for _, bad := range []string{`{`, `{}`, `{"models":[null]}`, `{"models":[{}]}`} {
+		if _, err := paseoAutoTierCatalog([]byte(bad), updates); err == nil {
+			t.Fatalf("accepted malformed catalog %q", bad)
+		}
+	}
+}
