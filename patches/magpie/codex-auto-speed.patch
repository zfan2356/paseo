+package provider
+
+import (
+	"path/filepath"
+	"slices"
+	"testing"
+
+	"github.com/yetone/magpie/internal/catalog"
+)
+
+func TestAutoPairAndMemberTiers(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("USERPROFILE", home)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(home, ".config"))
+	t.Setenv("XDG_CACHE_HOME", filepath.Join(home, ".cache"))
+	g := Group{Members: []string{"codex/gpt-test", "ichat/gpt-test"}}
+	if !IsCodexIchatAuto("auto/gpt-test", g) || IsCodexIchatAuto("group/test", g) || IsCodexIchatAuto("auto/other", g) {
+		t.Fatal("auto pair recognition differs from the requested route")
+	}
+	if IsCodexIchatAuto("auto/gpt-test", Group{Members: []string{"codex/gpt-test", "ichat/other"}}) {
+		t.Fatal("different models formed a pair")
+	}
+	if err := catalog.SaveLive("ichat", "fixture", []catalog.Model{
+		{ID: "gpt-test", Tiers: []string{"priority", "ultrafast"}},
+		{ID: "gpt-unknown"},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	p := Provider{ID: "ichat"}
+	if got := AutoMemberTiers(p, "gpt-test"); !slices.Equal(got, []string{"priority", "ultrafast"}) {
+		t.Fatalf("reported tiers = %v", got)
+	}
+	if got := AutoMemberTiers(p, "gpt-unknown"); len(got) != 0 {
+		t.Fatalf("unknown tiers invented: %v", got)
+	}
+	if err := catalog.SaveLive("codex-fixture", "fixture", []catalog.Model{{ID: "gpt-test", Tiers: []string{"priority"}}}); err != nil {
+		t.Fatal(err)
+	}
+	ms := []Member{{Provider: p, Model: "gpt-test"}, {Provider: Provider{ID: "codex-fixture"}, Model: "gpt-test"}}
+	if got := autoGroupTiers(ms); !slices.Equal(got, []string{"priority", "ultrafast"}) {
+		t.Fatalf("union tiers = %v", got)
+	}
+	if err := catalog.SaveLive("ichat", "fixture", []catalog.Model{{ID: "gpt-test", Tiers: []string{"ultrafast"}}}); err != nil {
+		t.Fatal(err)
+	}
+	if got := autoGroupTiers(ms); !slices.Equal(got, []string{"priority", "ultrafast"}) {
+		t.Fatalf("split tiers = %v", got)
+	}
+}
