+		body := []byte(`{"model":"auto/gpt-test","service_tier":"` + tt.asked + `","input":"hello"}`)
+		got := autoTierBody(provider.Responses, body, tt.tiers)
+		if tier := askedTier(got); tier != tt.want || !strings.Contains(string(got), `"input":"hello"`) {
+			t.Errorf("asked=%s tiers=%v got %s", tt.asked, tt.tiers, got)
