+package provider
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+)
+
+func privateFixture(t *testing.T, endpoint string) Provider {
+	t.Helper()
+	file := filepath.Join(t.TempDir(), "provider.yaml")
+	body := "bearer: fixture-only\nheaders:\n  X-Source: fixture-source\nnormalize_errors: true\nendpoints:\n  responses: " + endpoint + "/external\n  chat: " + endpoint + "/external\n  anthropic: " + endpoint + "/messages-api\nmodel_apis:\n  - prefix: alternate-\n    protocol: chat\n"
+	if err := os.WriteFile(file, []byte(body), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return Provider{ID: "private-fixture", PrivateConfig: file, Responses: "https://example.invalid/v1", Chat: "https://example.invalid/v1", Anthropic: "https://example.invalid"}
+}
+
+func TestPrivateProviderDirectAndSerialized(t *testing.T) {
+	calls := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		if r.Header.Get("Authorization") != "Bearer fixture-only" || r.Header.Get("X-Source") != "fixture-source" || r.Header.Get("X-Api-Key") != "" {
+			t.Error("wrong upstream authentication")
+		}
+		if r.URL.Path != "/external/responses" || r.URL.RawQuery != "q=1" {
+			t.Errorf("path: %s", r.URL)
+		}
+		w.Header().Set("Content-Type", "text/event-stream")
+		io.WriteString(w, "data: {\"type\":\"response.completed\"}\n\n")
+	}))
+	defer server.Close()
+	p := privateFixture(t, server.URL)
+	req, _ := http.NewRequest("POST", p.Responses+"/responses?q=1", strings.NewReader(`{"model":"m"}`))
+	req.Header.Set("X-Api-Key", "client-value")
+	if err := p.Sign(context.Background(), req, Responses, nil); err != nil {
+		t.Fatal(err)
+	}
+	res, err := p.Do(server.Client(), req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer res.Body.Close()
+	body, err := io.ReadAll(res.Body)
+	if err != nil || calls != 1 || strings.Contains(string(body), "failed") {
+		t.Fatalf("calls=%d body=%s err=%v", calls, body, err)
+	}
+	saved, _ := json.Marshal(p)
+	for _, secret := range []string{"fixture-only", "fixture-source", server.URL} {
+		if strings.Contains(string(saved), secret) {
+			t.Fatal("private material reached serialized provider")
+		}
+	}
+	if apis := p.APIs("alternate-m"); len(apis) != 1 || apis[0] != Chat {
+		t.Fatalf("protocol: %v", apis)
+	}
+}
+
+func TestPrivateProviderFailsClosed(t *testing.T) {
+	p := privateFixture(t, "https://example.invalid")
+	for _, text := range []string{"bearer: [private-secret", "bearer: private-secret\nunknown: private-value", "bearer: private-secret\n---\nbearer: second"} {
+		os.WriteFile(p.PrivateConfig, []byte(text), 0600)
+		_, err := p.privateSettings()
+		if err == nil || strings.Contains(err.Error(), "private-secret") || strings.Contains(err.Error(), p.PrivateConfig) {
+			t.Fatal("invalid config was accepted or disclosed")
+		}
+	}
+	p = privateFixture(t, "https://example.invalid")
+	os.Chmod(p.PrivateConfig, 0644)
+	if _, err := p.privateSettings(); err == nil && runtime.GOOS != "windows" {
+		t.Fatal("world-readable credentials accepted")
+	}
+	os.Remove(p.PrivateConfig)
+	req, _ := http.NewRequest("POST", p.Responses+"/responses", nil)
+	if err := p.Sign(context.Background(), req, Responses, nil); err == nil {
+		t.Fatal("missing config accepted")
+	}
+	if _, err := p.Do(http.DefaultClient, req); err == nil {
+		t.Fatal("unsigned request sent")
+	}
+}
+
+func TestPrivateProviderRedirectAndCancellation(t *testing.T) {
+	leaked := false
+	other := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { leaked = true }))
+	defer other.Close()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { http.Redirect(w, r, other.URL, 307) }))
+	defer server.Close()
+	p := privateFixture(t, server.URL)
+	req, _ := http.NewRequest("POST", p.Responses+"/responses", nil)
+	p.Sign(context.Background(), req, Responses, nil)
+	res, err := p.Do(server.Client(), req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	res.Body.Close()
+	if leaked || res.StatusCode != 307 {
+		t.Fatal("followed private redirect")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	req, _ = http.NewRequestWithContext(ctx, "POST", p.Responses+"/responses", nil)
+	p.Sign(ctx, req, Responses, nil)
+	if _, err := p.Do(server.Client(), req); err != context.Canceled {
+		t.Fatalf("cancel: %v", err)
+	}
+}
+
+func TestPrivateErrorsAndStream(t *testing.T) {
+	for _, tc := range []struct {
+		body     string
+		status   int
+		contains string
+	}{
+		{`{"error":{"message":"Error code: 429 - {'error': {'message': 'try later', 'code': 'rate_limit'}}"}}`, 429, `"code":"rate_limit"`},
+		{`{"error":{"message":"Error code: 400 - {\"error\":{\"message\":\"bad argument\",\"code\":\"invalid_prompt\"}}"}}`, 400, `"code":"invalid_prompt"`},
+		{`{"error":{"message":"Your input exceeds the context window of this model."}}`, 400, "context_length_exceeded"},
+		{`{"type":"error","error":{"message":"bad argument"}}`, 0, `"type":"error"`},
+	} {
+		b, status := normalizePrivateError([]byte(tc.body))
+		if status != tc.status || !strings.Contains(string(b), tc.contains) {
+			t.Fatalf("%d %s", status, b)
+		}
+	}
+	for _, tc := range []struct {
+		input     string
+		responses bool
+		want      string
+		unchanged bool
+	}{
+		{"data: {\"type\":\"response.created\"}\r\n\r\n", true, "response.failed", false},
+		{"data: {\"type\":\"response.completed\"}\n\n", true, "response.completed", true},
+		{"data: {\"type\":\"response.output_text.delta\",\"delta\":\"keep me\"}\n\n", true, "keep me", false},
+		{"event: error\ndata: {\"type\":\"error\",\"error\":{\"message\":\"Error code: 429 - {'error': {'message': 'busy'}}\"}}\n\n", true, `"status":429`, false},
+		{"event: error\ndata: {\"type\":\"error\",\"error\":{\"message\":\"busy\"}}\n\n", false, `"type":"error"`, false},
+	} {
+		r := newPrivateStream(io.NopCloser(strings.NewReader(tc.input)), tc.responses)
+		b, err := io.ReadAll(r)
+		r.Close()
+		if err != nil || !strings.Contains(string(b), tc.want) || tc.unchanged && string(b) != tc.input {
+			t.Fatalf("stream: %s %v", b, err)
+		}
+	}
+}
+
+func TestPrivateProviderModelPagesAndRotation(t *testing.T) {
+	calls := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		if r.URL.Path != "/external/models" || r.Header.Get("Authorization") != "Bearer rotated-fixture" {
+			t.Errorf("model request: %s", r.URL.Path)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		if r.URL.Query().Get("after_id") == "m1" {
+			io.WriteString(w, `{"data":[{"id":"m2"}],"has_more":false}`)
+		} else {
+			io.WriteString(w, `{"data":[{"id":"m1"}],"has_more":true,"last_id":"m1"}`)
+		}
+	}))
+	defer server.Close()
+	p := privateFixture(t, server.URL)
+	b, _ := os.ReadFile(p.PrivateConfig)
+	b = []byte(strings.ReplaceAll(string(b), "fixture-only", "rotated-fixture") + "exclude_models: [m2]\n")
+	os.WriteFile(p.PrivateConfig, b, 0600)
+	ms, err := p.List(context.Background())
+	if err != nil || len(ms) != 1 || ms[0].ID != "m1" || calls != 2 {
+		t.Fatalf("models=%v calls=%d err=%v", ms, calls, err)
+	}
+}
diff --git a/internal/provider/private_errors.go b/internal/provider/private_errors.go
new file mode 100644
index 0000000..3b9d5d1
--- /dev/null
+++ b/internal/provider/private_errors.go
@@ -0,0 +1,169 @@
+package provider
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"io"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+var privateWrapped = regexp.MustCompile(`(?s)^Error code: ([45][0-9]{2}) - (.*)$`)
+var privateFields = regexp.MustCompile(`['"](code|type|message)['"]\s*:\s*("(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*')`)
+
+// Read only string error fields from a repr-like wrapper; never evaluate it.
+func privateErrorFields(text string) map[string]any {
+	var v map[string]any
+	if json.Unmarshal([]byte(text), &v) == nil {
+		if inner, ok := v["error"].(map[string]any); ok {
+			return inner
+		}
+		return v
+	}
+	v = map[string]any{}
+	for _, m := range privateFields.FindAllStringSubmatch(text, -1) {
+		s := m[2]
+		if s[0] == '\'' {
+			s = `"` + strings.ReplaceAll(strings.ReplaceAll(s[1:len(s)-1], `\'`, `'`), `"`, `\"`) + `"`
+		}
+		if value, err := strconv.Unquote(s); err == nil {
+			v[m[1]] = value
+		}
+	}
+	return v
+}
+
+func normalizePrivateError(body []byte) ([]byte, int) {
+	var root map[string]any
+	if json.Unmarshal(body, &root) != nil {
+		return body, 0
+	}
+	parent := root
+	if response, ok := root["response"].(map[string]any); ok {
+		parent = response
+	}
+	e, ok := parent["error"].(map[string]any)
+	if !ok {
+		return body, 0
+	}
+	status := 0
+	msg, _ := e["message"].(string)
+	if m := privateWrapped.FindStringSubmatch(msg); m != nil {
+		status, _ = strconv.Atoi(m[1])
+		fields := privateErrorFields(m[2])
+		if len(fields) > 0 {
+			e = fields
+		}
+		e["status"] = status
+	}
+	msg, _ = e["message"].(string)
+	if strings.HasPrefix(msg, "Your input exceeds the context window of this model.") {
+		e["code"] = "context_length_exceeded"
+		e["status"], status = 400, 400
+	}
+	parent["error"] = e
+	out, err := json.Marshal(root)
+	if err != nil {
+		return body, 0
+	}
+	return out, status
+}
+
+type privateStream struct {
+	source    io.ReadCloser
+	scan      *bufio.Scanner
+	left      []byte
+	responses bool
+	terminal  bool
+	ended     bool
+}
+
+func newPrivateStream(source io.ReadCloser, responses bool) *privateStream {
+	s := bufio.NewScanner(source)
+	s.Buffer(make([]byte, 4096), 1<<20)
+	s.Split(func(data []byte, eof bool) (int, []byte, error) {
+		n := bytes.Index(data, []byte("\n\n"))
+		r := bytes.Index(data, []byte("\r\n\r\n"))
+		if r >= 0 && (n < 0 || r < n) {
+			return r + 4, data[:r+4], nil
+		}
+		if n >= 0 {
+			return n + 2, data[:n+2], nil
+		}
+		if eof && len(data) > 0 {
+			return len(data), data, nil
+		}
+		return 0, nil, nil
+	})
+	return &privateStream{source: source, scan: s, responses: responses}
+}
+
+func (s *privateStream) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+	for len(s.left) == 0 {
+		if s.ended {
+			return 0, io.EOF
+		}
+		if !s.scan.Scan() {
+			s.ended = true
+			if s.responses && !s.terminal {
+				s.left = []byte("event: response.failed\ndata: {\"type\":\"response.failed\",\"response\":{\"status\":\"failed\",\"error\":{\"message\":\"upstream stream ended before completion\",\"status\":502}}}\n\n")
+				break
+			}
+			if s.scan.Err() != nil {
+				return 0, io.ErrUnexpectedEOF
+			}
+			return 0, io.EOF
+		}
+		raw := bytes.Clone(s.scan.Bytes())
+		var data []byte
+		var eventName string
+		for _, line := range bytes.Split(raw, []byte("\n")) {
+			line = bytes.TrimSuffix(line, []byte("\r"))
+			if bytes.HasPrefix(line, []byte("event:")) {
+				eventName = strings.TrimSpace(string(line[6:]))
+			}
+			if bytes.HasPrefix(line, []byte("data:")) {
+				if len(data) > 0 {
+					data = append(data, '\n')
+				}
+				data = append(data, bytes.TrimPrefix(line[5:], []byte(" "))...)
+			}
+		}
+		var ev struct {
+			Type string `json:"type"`
+		}
+		json.Unmarshal(data, &ev)
+		if ev.Type == "" {
+			ev.Type = eventName
+		}
+		switch ev.Type {
+		case "response.completed", "response.failed", "response.cancelled", "response.incomplete", "error":
+			s.terminal = true
+		}
+		if ev.Type == "response.failed" || ev.Type == "error" {
+			out, _ := normalizePrivateError(data)
+			if s.responses && ev.Type == "error" {
+				var v map[string]any
+				json.Unmarshal(out, &v)
+				out, _ = json.Marshal(map[string]any{"type": "response.failed", "response": map[string]any{"status": "failed", "object": "response", "error": v["error"]}})
+			}
+			name := ev.Type
+			if s.responses {
+				name = "response.failed"
+			}
+			raw = append([]byte("event: "+name+"\ndata: "), out...)
+			raw = append(raw, '\n', '\n')
+		}
+		s.left = raw
+	}
+	n := copy(p, s.left)
+	s.left = s.left[n:]
+	return n, nil
+}
+
+func (s *privateStream) Close() error { return s.source.Close() }
