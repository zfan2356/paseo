+package gui
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+func TestPrivateProviderReferenceSurvivesWebSave(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	t.Setenv("USERPROFILE", os.Getenv("HOME"))
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	t.Setenv("XDG_CACHE_HOME", t.TempDir())
+	path := filepath.Join(t.TempDir(), "private.yaml")
+	if err := provider.Save(provider.Provider{ID: "relay", Name: "Relay", Chat: "https://example.invalid/v1", Key: "placeholder", PrivateConfig: path, Models: []string{"m"}}); err != nil {
+		t.Fatal(err)
+	}
+	mux := http.NewServeMux()
+	providerRoutes(mux, nil)
+	w := httptest.NewRecorder()
+	mux.ServeHTTP(w, httptest.NewRequest("POST", "/api/provider/save", strings.NewReader(`{"id":"relay","from":"relay","name":"Renamed","chat":"https://example.invalid/v1","models":["m"]}`)))
+	if w.Code != 200 {
+		t.Fatalf("save: %d %s", w.Code, w.Body)
+	}
+	p, err := provider.Find("relay")
+	if err != nil || p.PrivateConfig != path {
+		t.Fatal("web save dropped private reference")
+	}
+	w = httptest.NewRecorder()
+	mux.ServeHTTP(w, httptest.NewRequest("GET", "/api/providers", nil))
+	if strings.Contains(w.Body.String(), path) {
+		t.Fatal("web response exposed the local config path")
+	}
+}
