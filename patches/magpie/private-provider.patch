@@ -0,0 +1,90 @@
+package gateway
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+func privateGatewayProvider(t *testing.T, id string, upstream *scripted) {
+	t.Helper()
+	server := httptest.NewServer(upstream)
+	t.Cleanup(server.Close)
+	path := filepath.Join(t.TempDir(), "provider.yaml")
+	config := "bearer: fixture-only\nnormalize_errors: true\nendpoints:\n  responses: " + server.URL + "/external\n"
+	if err := os.WriteFile(path, []byte(config), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := provider.Save(provider.Provider{ID: id, Name: id, Key: "local-placeholder", PrivateConfig: path, Responses: "https://example.invalid/v1", Models: []string{"m"}}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestPrivateProviderGatewayReplayBoundary(t *testing.T) {
+	lead := "data: {\"type\":\"response.created\",\"response\":{\"id\":\"r\"}}\n\n"
+	content := "data: {\"type\":\"response.output_text.delta\",\"delta\":\"keep this output\"}\n\n"
+	errEvent := "data: {\"type\":\"error\",\"error\":{\"message\":\"Error code: 503 - {'error': {'message': 'busy'}}\"}}\n\n"
+	good := content + "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"r\",\"status\":\"completed\"}}\n\n"
+	for _, tc := range []struct {
+		name, first string
+		fallback    bool
+	}{
+		{"prelude-error", lead + errEvent, true},
+		{"prelude-eof", lead, true},
+		{"output-error", lead + content + errEvent, false},
+		{"output-eof", lead + content, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			fresh(t)
+			a := &scripted{replies: []reply{{200, "text/event-stream", tc.first}}}
+			b := &scripted{replies: []reply{{200, "text/event-stream", good}}}
+			privateGatewayProvider(t, "a", a)
+			privateGatewayProvider(t, "b", b)
+			if err := provider.SaveGroup(provider.Group{Name: "Private", Members: []string{"a/m", "b/m"}, Routing: provider.Ordered}); err != nil {
+				t.Fatal(err)
+			}
+			rec := httptest.NewRecorder()
+			New().Handler().ServeHTTP(rec, httptest.NewRequest("POST", "/v1/responses", strings.NewReader(`{"model":"group/private","stream":true,"input":"hi"}`)))
+			if rec.Code != 200 || a.n != 1 || (b.n == 1) != tc.fallback || !strings.Contains(rec.Body.String(), "keep this output") {
+				t.Fatalf("status=%d a=%d b=%d body=%s", rec.Code, a.n, b.n, rec.Body)
+			}
+		})
+	}
+}
+
+func TestPrivateProviderGatewayErrorClassification(t *testing.T) {
+	for _, status := range []int{400, 401, 429, 503} {
+		if got := streamStatus(`{"status":` + fmt.Sprint(status) + `,"message":"wrapped failure"}`); got != status {
+			t.Fatalf("status: %d != %d", got, status)
+		}
+	}
+}
+
+func TestPrivateProviderGatewayRateAndInvalidRequest(t *testing.T) {
+	fresh(t)
+	good := "data: {\"type\":\"response.output_text.delta\",\"delta\":\"done\"}\n\ndata: {\"type\":\"response.completed\",\"response\":{\"status\":\"completed\"}}\n\n"
+	a := &scripted{replies: []reply{{429, "application/json", `{"error":{"message":"Error code: 429 - {'error': {'message': 'rate limited'}}"}}`}, {200, "text/event-stream", good}}, limited: http.Header{"Retry-After": []string{"1"}}}
+	privateGatewayProvider(t, "a", a)
+	s := New()
+	start := time.Now()
+	rec := httptest.NewRecorder()
+	s.Handler().ServeHTTP(rec, httptest.NewRequest("POST", "/v1/responses", strings.NewReader(`{"model":"a/m","stream":true,"input":"hi"}`)))
+	if a.n != 2 || time.Since(start) < time.Second || !strings.Contains(rec.Body.String(), "done") {
+		t.Fatalf("retry: attempts=%d body=%s", a.n, rec.Body)
+	}
+	fresh(t)
+	a = &scripted{replies: []reply{{500, "application/json", `{"error":{"message":"Error code: 400 - {'error': {'message': 'bad argument', 'type': 'invalid_request_error'}}"}}`}}}
+	privateGatewayProvider(t, "a", a)
+	rec = httptest.NewRecorder()
+	New().Handler().ServeHTTP(rec, httptest.NewRequest("POST", "/v1/responses", strings.NewReader(`{"model":"a/m","stream":true,"input":"hi"}`)))
+	if a.n != 1 || rec.Code != 400 {
+		t.Fatalf("invalid request: attempts=%d status=%d body=%s", a.n, rec.Code, rec.Body)
+	}
+}
