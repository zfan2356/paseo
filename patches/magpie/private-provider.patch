diff --git a/internal/provider/private_config.go b/internal/provider/private_config.go
new file mode 100644
index 0000000..d88bdef
--- /dev/null
+++ b/internal/provider/private_config.go
@@ -0,0 +1,206 @@
+package provider
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"runtime"
+	"slices"
+	"strings"
+
+	"github.com/yetone/magpie/internal/catalog"
+	"gopkg.in/yaml.v3"
+)
+
+type privateConfig struct {
+	Endpoints       map[Protocol]string `yaml:"endpoints"`
+	Bearer          string              `yaml:"bearer"`
+	Headers         map[string]string   `yaml:"headers"`
+	NormalizeErrors bool                `yaml:"normalize_errors"`
+	ExcludeModels   []string            `yaml:"exclude_models"`
+	ModelAPIs       []struct {
+		Prefix   string   `yaml:"prefix"`
+		Protocol Protocol `yaml:"protocol"`
+	} `yaml:"model_apis"`
+}
+
+type privateRequestKey struct{}
+
+type privateListTransport struct {
+	provider Provider
+	protocol Protocol
+}
+
+func (t privateListTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	req = req.Clone(req.Context())
+	if err := t.provider.Sign(req.Context(), req, t.protocol, nil); err != nil {
+		return nil, err
+	}
+	return t.provider.Do(http.DefaultClient, req)
+}
+
+func (p Provider) listPrivate(ctx context.Context) ([]catalog.Model, error) {
+	cfg, err := p.privateSettings()
+	if err != nil {
+		return nil, err
+	}
+	proto := Chat
+	if p.Chat == "" {
+		proto = Responses
+	}
+	if p.Base(proto) == "" || cfg.Endpoints[proto] == "" {
+		return nil, errPrivateConfig
+	}
+	client := &http.Client{Transport: privateListTransport{p, proto}, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	ms, err := catalog.FetchURLWithClient(ctx, strings.TrimRight(p.Base(proto), "/")+"/models", "", false, nil, client)
+	if err != nil {
+		return nil, errors.New("private provider model list could not be read")
+	}
+	ms = slices.DeleteFunc(ms, func(m catalog.Model) bool { return slices.Contains(cfg.ExcludeModels, m.ID) })
+	return catalog.Chat(ms), nil
+}
+
+// Errors must not contain YAML values, filenames or upstream addresses.
+var errPrivateConfig = errors.New("private provider configuration is missing, invalid, or not owner-only")
+
+func (p Provider) privateSettings() (*privateConfig, error) {
+	path := p.PrivateConfig
+	if strings.HasPrefix(path, "~/") {
+		home, err := os.UserHomeDir()
+		if err != nil {
+			return nil, errPrivateConfig
+		}
+		path = filepath.Join(home, path[2:])
+	}
+	if !filepath.IsAbs(path) || p.Account != nil || len(p.Keys) != 0 {
+		return nil, errPrivateConfig
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, errPrivateConfig
+	}
+	defer f.Close()
+	info, err := f.Stat()
+	if err != nil || !info.Mode().IsRegular() || info.Size() > 1<<20 || runtime.GOOS != "windows" && info.Mode().Perm()&0077 != 0 {
+		return nil, errPrivateConfig
+	}
+	var cfg privateConfig
+	d := yaml.NewDecoder(io.LimitReader(f, 1<<20))
+	d.KnownFields(true)
+	if d.Decode(&cfg) != nil || cfg.Bearer == "" || strings.ContainsAny(cfg.Bearer, " \t\r\n") {
+		return nil, errPrivateConfig
+	}
+	var extra any
+	if d.Decode(&extra) != io.EOF {
+		return nil, errPrivateConfig
+	}
+	for proto, endpoint := range cfg.Endpoints {
+		if proto != Chat && proto != Responses && proto != Anthropic {
+			return nil, errPrivateConfig
+		}
+		u, err := url.Parse(endpoint)
+		if err != nil || u.Host == "" || (u.Scheme != "https" && u.Scheme != "http") || u.User != nil || u.RawQuery != "" || u.Fragment != "" {
+			return nil, errPrivateConfig
+		}
+	}
+	for k, v := range cfg.Headers {
+		if !privateHeader(k) || strings.ContainsAny(v, "\r\n") {
+			return nil, errPrivateConfig
+		}
+	}
+	for _, rule := range cfg.ModelAPIs {
+		if rule.Prefix == "" || cfg.Endpoints[rule.Protocol] == "" {
+			return nil, errPrivateConfig
+		}
+	}
+	return &cfg, nil
+}
+
+func privateHeader(k string) bool {
+	if k == "" {
+		return false
+	}
+	for _, c := range k {
+		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || strings.ContainsRune("!#$%&'*+-.^_`|~", c)) {
+			return false
+		}
+	}
+	switch strings.ToLower(k) {
+	case "authorization", "x-api-key", "host", "content-length", "transfer-encoding", "connection", "proxy-authorization":
+		return false
+	}
+	return true
+}
+
+func (p Provider) signPrivate(req *http.Request, proto Protocol) error {
+	cfg, err := p.privateSettings()
+	if err != nil {
+		return err
+	}
+	base, err := url.Parse(p.Base(proto))
+	if err != nil || base.Host != req.URL.Host || base.Scheme != req.URL.Scheme || cfg.Endpoints[proto] == "" {
+		return errPrivateConfig
+	}
+	prefix := strings.TrimRight(base.Path, "/") + "/"
+	if !strings.HasPrefix(req.URL.Path, prefix) {
+		return errPrivateConfig
+	}
+	u, err := url.Parse(strings.TrimRight(cfg.Endpoints[proto], "/") + "/" + strings.TrimPrefix(req.URL.Path, prefix))
+	if err != nil {
+		return errPrivateConfig
+	}
+	u.RawQuery = req.URL.RawQuery
+	req.URL, req.Host = u, ""
+	req.Header.Del("Authorization")
+	req.Header.Del("X-Api-Key")
+	req.Header.Set("Authorization", "Bearer "+cfg.Bearer)
+	for k, v := range cfg.Headers {
+		req.Header.Set(k, v)
+	}
+	*req = *req.WithContext(context.WithValue(req.Context(), privateRequestKey{}, cfg))
+	return nil
+}
+
+func (p Provider) doPrivate(client *http.Client, req *http.Request) (*http.Response, error) {
+	cfg, ok := req.Context().Value(privateRequestKey{}).(*privateConfig)
+	if !ok {
+		return nil, errPrivateConfig
+	}
+	// A redirect must never carry private authentication to a different endpoint.
+	c := *client
+	c.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	res, err := c.Do(req)
+	if err != nil {
+		if req.Context().Err() != nil {
+			return nil, req.Context().Err()
+		}
+		return nil, errors.New("private provider transport failed")
+	}
+	if !cfg.NormalizeErrors {
+		return res, nil
+	}
+	if strings.Contains(res.Header.Get("Content-Type"), "text/event-stream") {
+		res.Body = newPrivateStream(res.Body, strings.HasSuffix(req.URL.Path, "/responses"))
+		res.ContentLength = -1
+		res.Header.Del("Content-Length")
+	} else if res.StatusCode >= 400 {
+		body, err := io.ReadAll(io.LimitReader(res.Body, (1<<20)+1))
+		res.Body.Close()
+		if err != nil || len(body) > 1<<20 {
+			return nil, errors.New("private provider error response could not be read")
+		}
+		body, status := normalizePrivateError(body)
+		if status != 0 {
+			res.StatusCode = status
+		}
+		res.Body = io.NopCloser(bytes.NewReader(body))
+		res.ContentLength = int64(len(body))
+		res.Header.Del("Content-Length")
+	}
+	return res, nil
+}
