+func TestPortCodexRolloutsPreservesPaginatedOffsets(t *testing.T) {
+	for _, zst := range []bool{false, true} {
+		t.Run(map[bool]string{false: "plain", true: "zst"}[zst], func(t *testing.T) {
+			lines := portRolloutLines(strings.Repeat("Retained context. ", 100))
+			for i, line := range lines {
+				entry := decode(t, line)
+				entry["ordinal"] = i
+				if i == 0 {
+					entry["payload"].(map[string]any)["history_mode"] = "paginated"
+				}
+				encoded, err := json.Marshal(entry)
+				if err != nil {
+					t.Fatal(err)
+				}
+				lines[i] = string(encoded)
+			}
+			home, path := portHome(t, lines, zst)
+			before, err := os.ReadFile(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			res, err := PortCodexRollouts(context.Background(), home)
+			if err != nil || !res.Done || len(res.Rewritten) != 0 || len(res.Held) != 0 {
+				t.Fatalf("paginated pass: %+v, %v", res, err)
+			}
+			after, err := os.ReadFile(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(before, after) {
+				t.Fatal("rewrote indexed history: native SQLite byte offsets are now stale")
+			}
+		})
+	}
+}
