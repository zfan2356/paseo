+func TestCodexEncodingRetryBoundaries(t *testing.T) {
+	for _, test := range []struct {
+		name, path, encoding, reply string
+		status, calls               int
+	}{
+		{"opaque", "/responses", "", `{"detail":"Bad Request"}`, 400, 2},
+		{"specific", "/responses", "", `{"detail":"Invalid input item"}`, 400, 1},
+		{"structured", "/responses", "", `{"error":{"type":"invalid_request_error","message":"Bad Request"}}`, 400, 1},
+		{"quota", "/responses", "", `{"detail":"Bad Request"}`, 429, 1},
+		{"server", "/responses", "", `{"detail":"Bad Request"}`, 503, 1},
+		{"empty", "/responses", "", "", 400, 1},
+		{"long", "/responses", "", strings.Repeat("x", 5000), 400, 1},
+		{"SSE", "/responses", "", "data: {\"type\":\"response.failed\"}\n\n", 200, 1},
+		{"compact", "/responses/compact", "", `{"detail":"Bad Request"}`, 400, 1},
+		{"preencoded", "/responses", "gzip", `{"detail":"Bad Request"}`, 400, 1},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			t.Cleanup(CodexZstdForTests(true))
+			calls := 0
+			var first, second []byte
+			up := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				calls++
+				wire, _ := io.ReadAll(r.Body)
+				if calls == 1 {
+					first = wire
+				} else {
+					second = wire
+				}
+				if r.Header.Get("Authorization") != "Bearer example" || r.Header.Get("Session-Id") != "same-session" {
+					t.Error("retry changed the account or session")
+				}
+				w.WriteHeader(test.status)
+				io.WriteString(w, test.reply)
+			}))
+			defer up.Close()
+			was := CodexBase
+			CodexBase = up.URL
+			defer func() { CodexBase = was }()
+			var text strings.Builder
+			for n := range 3000 {
+				fmt.Fprintf(&text, "Tool %d returned status %d: %s\n", n%73, n%7, strings.Repeat("preserved request ", n%9+1))
+			}
+			body, _ := json.Marshal(map[string]any{"model": "gpt-6-astra", "input": text.String()})
+			req, _ := http.NewRequest("POST", CodexBase+test.path, bytes.NewReader(body))
+			req.Header.Set("Authorization", "Bearer example")
+			req.Header.Set("Session-Id", "same-session")
+			if test.encoding != "" {
+				req.Header.Set("Content-Encoding", test.encoding)
+			}
+			res, sent, err := CodexDo(req, body, up.Client().Do)
+			if err != nil {
+				t.Fatal(err)
+			}
+			got, _ := io.ReadAll(res.Body)
+			res.Body.Close()
+			if calls != test.calls || res.StatusCode != test.status || string(got) != test.reply {
+				t.Fatalf("calls=%d status=%d response bytes=%d", calls, res.StatusCode, len(got))
+			}
+			if calls == 2 {
+				if bytes.Equal(first, second) || sent != len(second) {
+					t.Fatal("retry did not change the encoding or report its actual wire size")
+				}
+				d, _ := zstd.NewReader(nil)
+				defer d.Close()
+				for _, wire := range [][]byte{first, second} {
+					plain, err := d.DecodeAll(wire, nil)
+					if err != nil || !bytes.Equal(plain, body) {
+						t.Fatalf("retry changed JSON: %v", err)
+					}
+				}
+			}
+		})
+	}
+}
+
+func TestCodexEncodingRetryHonorsCancellation(t *testing.T) {
+	t.Cleanup(CodexZstdForTests(true))
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	body := []byte(`{"input":"hello"}`)
+	req, _ := http.NewRequestWithContext(ctx, "POST", CodexBase+"/responses", bytes.NewReader(body))
+	calls := 0
+	res, _, err := CodexDo(req, body, func(*http.Request) (*http.Response, error) {
+		calls++
+		cancel()
+		return &http.Response{StatusCode: 400, Body: io.NopCloser(strings.NewReader(`{"detail":"Bad Request"}`))}, nil
+	})
+	if res != nil || err != context.Canceled || calls != 1 {
+		t.Fatalf("response=%v error=%v calls=%d", res, err, calls)
+	}
+}
 
