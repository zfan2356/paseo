+func TestCodexOpaqueCompressedRefusalRecovers(t *testing.T) {
+	for _, model := range []string{"gpt-6-astra", "codex/gpt-6-astra"} {
+		t.Run(model, func(t *testing.T) {
+			codexSignedIn(t, "spare@example.com")
+			zstdTurns(t)
+			var firstWire, firstJSON []byte
+			var accounts []string
+			up := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				wire, _ := io.ReadAll(r.Body)
+				d, _ := zstd.NewReader(nil)
+				plain, err := d.DecodeAll(wire, nil)
+				d.Close()
+				if err != nil {
+					t.Errorf("decode: %v", err)
+				}
+				accounts = append(accounts, r.Header.Get("chatgpt-account-id"))
+				if len(accounts) == 1 {
+					firstWire, firstJSON = wire, plain
+					w.WriteHeader(400)
+					io.WriteString(w, `{"detail":"Bad Request"}`)
+					return
+				}
+				if !bytes.Equal(plain, firstJSON) || bytes.Equal(wire, firstWire) {
+					t.Error("retry must change the encoding and preserve the exact JSON")
+				}
+				if r.Header.Get("Content-Encoding") != "zstd" || r.ContentLength != int64(len(wire)) {
+					t.Error("retry lost its compression or Content-Length")
+				}
+				io.WriteString(w, sse(
+					`data: {"type":"response.output_text.delta","delta":"recovered"}`,
+					`data: {"type":"response.completed","response":{"id":"r1","usage":{"input_tokens":7,"output_tokens":1}}}`,
+				))
+			}))
+			defer up.Close()
+			was := provider.CodexBase
+			provider.CodexBase = up.URL + "/backend-api/codex"
+			defer func() { provider.CodexBase = was }()
+			turn := withModel([]byte(textTurn(270000)), model)
+			code, reply := codexPost(t, string(turn))
+			if code != 200 || !strings.Contains(reply, "recovered") {
+				t.Fatalf("status %d: %.300s", code, reply)
+			}
+			if len(accounts) != 2 || accounts[0] != accounts[1] {
+				t.Fatalf("encoding recovery changed accounts: %v", accounts)
+			}
+		})
+	}
