 func newCodexZstd() *zstd.Encoder {
+	return codexZstdLevel(zstd.SpeedDefault)
+}
+
+func codexZstdLevel(level zstd.EncoderLevel) *zstd.Encoder {
 	z, _ := zstd.NewWriter(nil,
-		zstd.WithEncoderLevel(zstd.SpeedDefault),
+		zstd.WithEncoderLevel(level),
 		zstd.WithEncoderCRC(false),
 		zstd.WithWindowSize(2<<20),
 		zstd.WithEncoderConcurrency(2),
 		zstd.WithLowerEncoderMem(true),
 	)
 	return z
+}
+
+var codexZstdCompatible = sync.OnceValue(func() *zstd.Encoder {
+	return codexZstdLevel(zstd.SpeedBetterCompression)
+})
+
+// CodexDo retries an opaque compressed-body refusal once with another
+// encoder. The signed JSON and account stay identical; no SSE is replayed.
+func CodexDo(req *http.Request, body []byte, do func(*http.Request) (*http.Response, error)) (*http.Response, int, error) {
+	owned := req.Header.Get("Content-Encoding") == "" || strings.EqualFold(req.Header.Get("Content-Encoding"), "identity")
+	sent := CodexCompressed(req, body)
+	res, err := do(req)
+	if err != nil || !owned || req.Method != http.MethodPost || !codexTurnURL(req.URL) ||
+		req.Header.Get("Content-Encoding") != "zstd" || res.StatusCode != http.StatusBadRequest {
+		return res, sent, err
+	}
+	head, readErr := io.ReadAll(io.LimitReader(res.Body, 4097))
+	if readErr != nil {
+		res.Body.Close()
+		return nil, sent, readErr
+	}
+	if len(head) > 4096 || !codexOpaqueBadRequest(head) {
+		res.Body = struct {
+			io.Reader
+			io.Closer
+		}{io.MultiReader(bytes.NewReader(head), res.Body), res.Body}
+		return res, sent, nil
+	}
+	res.Body.Close()
+	if err := req.Context().Err(); err != nil {
+		return nil, sent, err
+	}
+	retry := req.Clone(req.Context())
+	wire := codexZstdCompatible().EncodeAll(body, nil)
+	retry.Body = io.NopCloser(bytes.NewReader(wire))
+	retry.GetBody = func() (io.ReadCloser, error) {
+		return io.NopCloser(bytes.NewReader(wire)), nil
+	}
+	retry.ContentLength = int64(len(wire))
+	retry.Header.Del("Content-Length")
+	res, err = do(retry)
+	status := 0
+	if res != nil {
+		status = res.StatusCode
+	}
+	log.Printf("codex: retried opaque zstd HTTP 400 with compatible encoding; session=%q bytes=%d status=%d",
+		req.Header.Get("Session-Id"), len(body), status)
+	return res, len(wire), err
+}
+
+func codexOpaqueBadRequest(body []byte) bool {
+	var fields map[string]json.RawMessage
+	var detail string
+	return json.Unmarshal(body, &fields) == nil && len(fields) == 1 &&
+		json.Unmarshal(fields["detail"], &detail) == nil && detail == "Bad Request"
 }
 
