+	})
+	up := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		ichatCalls.Add(1)
+		b, _ := io.ReadAll(r.Body)
+		if strings.Contains(string(b), "opaque-native") || !strings.Contains(string(b), "azalea-42") {
+			w.WriteHeader(400)
+			io.WriteString(w, `{"error":{"code":"invalid_encrypted_content","message":"The encrypted content for item cmp_legacy could not be verified."}}`)
+			return
+		}
+		w.Header().Set("Content-Type", "text/event-stream")
+		io.WriteString(w, sse(`data: {"type":"response.output_text.delta","delta":"azalea-42"}`, `data: {"type":"response.completed","response":{"id":"reply","object":"response","status":"completed","output":[{"type":"message","id":"msg_reply","role":"assistant","content":[{"type":"output_text","text":"azalea-42"}]}]}}`))
+	}))
+	t.Cleanup(up.Close)
+	if err := provider.Save(provider.Provider{ID: "ichat", Name: "iChat", Key: "fixture", Models: []string{"gpt-6.1-sol"}, Responses: up.URL + "/v1"}); err != nil {
+		t.Fatal(err)
+	}
+	s := New()
+	turn := func(checkpoint string) *httptest.ResponseRecorder {
+		req := httptest.NewRequest("POST", CodexPath+"/responses", strings.NewReader(`{"model":"ichat/gpt-6.1-sol","stream":true,"service_tier":"ultrafast","input":[`+checkpoint+`,{"type":"message","role":"user","content":[{"type":"input_text","text":"what was the lookup result?"}]}]}`))
+		req.Header.Set("Authorization", "Bearer header.payload.signature")
+		req.Header.Set("chatgpt-account-id", "acct-native")
+		req.Header.Set("session_id", "legacy-native")
+		rec := httptest.NewRecorder()
+		s.Handler().ServeHTTP(rec, req)
+		return rec
+	}
+	first := turn(`{"type":"compaction","id":"cmp_legacy","encrypted_content":"opaque-native"}`)
+	if first.Code != 200 {
+		t.Fatalf("migration failed: %d %s", first.Code, first.Body.String())
+	}
+	item := portableOutput(t, first.Body.String())
+	if nativeCalls.Load() != 1 || ichatCalls.Load() != 1 || !strings.Contains(first.Body.String(), `"delta":"azalea-42"`) {
+		t.Fatalf("legacy context reached the wrong source: native=%d ichat=%d", nativeCalls.Load(), ichatCalls.Load())
+	}
+	second := turn(string(item))
+	if second.Code != 200 || !strings.Contains(second.Body.String(), "azalea-42") || nativeCalls.Load() != 1 || ichatCalls.Load() != 2 {
+		t.Fatalf("portable replay failed: native=%d ichat=%d %d %s", nativeCalls.Load(), ichatCalls.Load(), second.Code, second.Body.String())
+	}
+}
