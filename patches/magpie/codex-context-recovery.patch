diff --git a/internal/gateway/codex_portable_compaction.go b/internal/gateway/codex_portable_compaction.go
new file mode 100644
index 00000000..ac537d87
--- /dev/null
+++ b/internal/gateway/codex_portable_compaction.go
@@ -0,0 +1,192 @@
+package gateway
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"net/http"
+	"sort"
+	"strings"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+type portableCompactionContextKey struct{}
+
+func signedCodexRequest(r *http.Request) bool {
+	return !apiKey(r.Header) && r.Header.Get("chatgpt-account-id") != "" && strings.Count(r.Header.Get("Authorization"), ".") == 2
+}
+
+// A Codex sign-in can open its old native checkpoint before the request
+// moves to iChat. Return a portable compaction item so the client replaces
+// that checkpoint once, instead of dropping it or migrating every turn.
+func (s *Server) migrateCodexCompaction(w http.ResponseWriter, r *http.Request, body []byte, model string) bool {
+	if !signedCodexRequest(r) || len(sealedCompactions(body)) == 0 || s.nativeCompactionFor(model) {
+		return false
+	}
+	source := portableCompactionSource(model)
+	if source == "" {
+		return false
+	}
+	// Explicit native compaction remains bound to its recorded writer.
+	if writer, gone, _ := sealedCompact(r, source, body); writer != nil || gone != "" {
+		return false
+	}
+	checkpoint := &recorder{header: http.Header{}, status: 200}
+	s.codexPortableCompact(checkpoint, r, body, source, nil, true)
+	if checkpoint.status >= 400 {
+		w.WriteHeader(checkpoint.status)
+		w.Write(checkpoint.body.Bytes())
+		return true
+	}
+	var migrated obj
+	var output []json.RawMessage
+	if decodeJSON(checkpoint.body.Bytes(), &migrated) != nil || decodeJSON(migrated["output"], &output) != nil || len(output) != 1 {
+		writeError(w, provider.Responses, 502, "context migration produced no checkpoint")
+		return true
+	}
+	var request obj
+	var items []json.RawMessage
+	if decodeJSON(body, &request) != nil || decodeJSON(request["input"], &items) != nil {
+		writeError(w, provider.Responses, 400, "context migration requires an input history")
+		return true
+	}
+	kept := []json.RawMessage{output[0]}
+	for _, item := range items {
+		var kind struct {
+			Type string `json:"type"`
+		}
+		if decodeJSON(item, &kind) == nil && (kind.Type == "compaction" || kind.Type == "compaction_summary") {
+			continue
+		}
+		kept = append(kept, item)
+	}
+	request["input"] = raw(kept)
+	rewritten, _ := json.Marshal(request)
+	rewritten, _ = codexInputAs(rewritten, true, false)
+	continued := &recorder{header: http.Header{}, status: 200}
+	s.serveAgent(continued, askWhole(r), provider.Responses, rewritten)
+	if continued.status >= 400 {
+		w.WriteHeader(continued.status)
+		w.Write(continued.body.Bytes())
+		return true
+	}
+	reply, replyItems, ok := handoffResponse(continued.body.Bytes())
+	if !ok {
+		writeError(w, provider.Responses, 502, "context migration continuation returned no response")
+		return true
+	}
+	reply["output"] = raw(append(output, replyItems...))
+	reply["object"] = raw("response")
+	result, _ := json.Marshal(reply)
+	for key, values := range continued.header {
+		if !hopHeader(key) && !strings.EqualFold(key, "Content-Length") {
+			w.Header()[key] = values
+		}
+	}
+	if streamOf(body) {
+		w.Header().Set("Content-Type", "text/event-stream")
+		w.WriteHeader(200)
+		wholeAsStream(w, provider.Responses, result)
+	} else {
+		w.Header().Set("Content-Type", "application/json")
+		w.Write(result)
+	}
+	return true
+}
+
+// A relay can stream even when asked for a whole reply. Preserve its raw
+// items while buffering this one migration, then use the existing SSE
+// encoder to send the new checkpoint and the actual answer together.
+func handoffResponse(body []byte) (obj, []json.RawMessage, bool) {
+	var reply obj
+	var items []json.RawMessage
+	if decodeJSON(body, &reply) == nil && decodeJSON(reply["output"], &items) == nil && len(items) > 0 {
+		return reply, items, true
+	}
+	byIndex := map[int]json.RawMessage{}
+	completed := false
+	err := readSSE(bytes.NewReader(body), func(_, data string) error {
+		var event obj
+		if decodeJSON([]byte(data), &event) != nil {
+			return nil
+		}
+		switch str(event, "type") {
+		case "response.output_item.done":
+			var index int
+			if decodeJSON(event["output_index"], &index) == nil {
+				byIndex[index] = event["item"]
+			}
+		case "response.completed":
+			completed = decodeJSON(event["response"], &reply) == nil
+		}
+		return nil
+	})
+	if err != nil || !completed {
+		return nil, nil, false
+	}
+	if decodeJSON(reply["output"], &items) != nil || len(items) == 0 {
+		var indexes []int
+		for index := range byIndex {
+			indexes = append(indexes, index)
+		}
+		sort.Ints(indexes)
+		for _, index := range indexes {
+			items = append(items, byIndex[index])
+		}
+	}
+	return reply, items, len(items) > 0
+}
+
+func portableCompactionSource(model string) string {
+	if strings.HasPrefix(model, "ichat/gpt-") {
+		return strings.TrimPrefix(model, "ichat/")
+	}
+	_, members, found := provider.FindGroup(model)
+	if !found {
+		return ""
+	}
+	source, ichat := "", false
+	for _, member := range members {
+		if member.Provider.ID == "codex" && strings.HasPrefix(member.Model, "gpt-") {
+			source = member.Model
+		}
+		ichat = ichat || member.Provider.ID == "ichat"
+	}
+	if ichat {
+		return source
+	}
+	return ""
+}
+
+func (s *Server) codexPortableCompact(w http.ResponseWriter, r *http.Request, body []byte, model string, on *provider.Provider, jsonResult bool) {
+	body, _ = codexInput(withModel(body, model), false)
+	body = plainItemIDs(boundCallIDs(callItemIDs(body)))
+	var request map[string]json.RawMessage
+	var items []json.RawMessage
+	if decodeJSON(body, &request) != nil || decodeJSON(request["input"], &items) != nil {
+		writeError(w, provider.Responses, 400, "compaction requires an input history")
+		return
+	}
+	kept := items[:0:0]
+	for _, item := range items {
+		var kind struct {
+			Type string `json:"type"`
+		}
+		if decodeJSON(item, &kind) == nil && kind.Type == "compaction_trigger" {
+			continue
+		}
+		kept = append(kept, item)
+	}
+	prompt, _ := json.Marshal(userMessage(codexCompactPrompt + "\nPreserve concrete values from tool results and pending requests. Do not perform tasks or call tools."))
+	request["input"], _ = json.Marshal(append(kept, prompt))
+	request["stream"], request["store"], request["tools"] = json.RawMessage("true"), json.RawMessage("false"), json.RawMessage("[]")
+	for _, field := range []string{"previous_response_id", "tool_choice", "parallel_tool_calls", "response_format", "text"} {
+		delete(request, field)
+	}
+	body, _ = json.Marshal(request)
+	r = r.WithContext(context.WithValue(r.Context(), portableCompactionContextKey{}, true))
+	s.codexCompactUsing(w, r, body, func(out http.ResponseWriter, request *http.Request, history []byte) {
+		s.codexUpstreamOn(out, request, "/responses", history, on)
+	}, jsonResult)
+}
