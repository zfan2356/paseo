+			}))
+			t.Cleanup(up.Close)
+			if err := provider.Save(provider.Provider{ID: "ichat", Name: "iChat", Key: "fixture", Models: []string{"gpt-6.1-sol"}, Responses: up.URL + "/v1"}); err != nil {
