+package gateway
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"net/http"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// Native Codex requests bypass candidate affinity. Scope refused reasoning
+// to the actual sign-in and conversation instead of sharing a native seat.
+func codexReasoningKey(r *http.Request, body []byte, base string, on *provider.Provider) string {
+	owner := base + "\x00" + r.Header.Get("Authorization") + "\x00" + r.Header.Get("chatgpt-account-id")
+	if on != nil && on.Account != nil {
+		owner += "\x00" + on.ID + "\x00" + on.Account.User
+	}
+	return fmt.Sprintf("codex-native/%x/%s|%s", sha256.Sum256([]byte(owner)), modelOf(body), conversationID(r.Header, body))
+}
+
+func recoverCodexReasoning(key string, body, refusal []byte, keepCompaction bool) ([]byte, bool) {
+	b, ok := withoutUnreadable(body, refusal)
+	if ok && keepCompaction && len(sealedCompactions(b)) < len(sealedCompactions(body)) {
+		return nil, false
+	}
+	if !ok || len(seals(b, "reasoning")) >= len(seals(body, "reasoning")) {
+		return b, ok
+	}
+	kept := map[[sha256.Size]byte]bool{}
+	for _, seal := range seals(b, "reasoning") {
+		kept[seal] = true
+	}
+	var original struct {
+		Input []sealedItem `json:"input"`
+	}
+	if decodeJSON(body, &original) != nil {
+		return b, ok
+	}
+	var removed []sealedItem
+	for _, item := range original.Input {
+		if item.Type == "reasoning" && item.Enc != "" && !kept[sha256.Sum256([]byte(item.Enc))] {
+			removed = append(removed, item)
+		}
+	}
+	if rejected, err := json.Marshal(map[string]any{"input": removed}); err == nil {
+		refused(key, "native", rejected, "reasoning")
+	}
+	return b, ok
+}
