@@ -0,0 +1,221 @@
+package gateway
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/yetone/magpie/internal/codexsummary"
+	"github.com/yetone/magpie/internal/provider"
+)
+
+func portableOutput(t *testing.T, body string) json.RawMessage {
+	t.Helper()
+	var response struct {
+		Output []json.RawMessage `json:"output"`
+	}
+	if strings.HasPrefix(strings.TrimSpace(body), "{") {
+		if err := json.Unmarshal([]byte(body), &response); err != nil {
+			t.Fatal(err)
+		}
+	} else {
+		for _, line := range strings.Split(body, "\n") {
+			if !strings.HasPrefix(line, "data: ") {
+				continue
+			}
+			var event struct {
+				Type     string          `json:"type"`
+				Response json.RawMessage `json:"response"`
+			}
+			json.Unmarshal([]byte(strings.TrimPrefix(line, "data: ")), &event)
+			if event.Type == "response.completed" {
+				json.Unmarshal(event.Response, &response)
+			}
+		}
+	}
+	if len(response.Output) < 1 {
+		t.Fatalf("expected a portable checkpoint: %s", body)
+	}
+	var item struct {
+		Type string `json:"type"`
+		Enc  string `json:"encrypted_content"`
+	}
+	json.Unmarshal(response.Output[0], &item)
+	message, ours := codexsummary.Message(item.Enc)
+	if item.Type != "compaction" || !ours || message == nil {
+		t.Fatalf("checkpoint cannot move to iChat: %s", body)
+	}
+	b, _ := json.Marshal(message)
+	if !strings.Contains(string(b), "azalea-42") {
+		t.Fatalf("checkpoint lost the earlier tool result: %s", b)
+	}
+	return response.Output[0]
+}
+
+func TestNativeCompactionIsPortableWhenNativeIsOff(t *testing.T) {
+	setup(t, provider.Chat, &fake{t: t})
+	var path string
+	var request []byte
+	var mu sync.Mutex
+	chatgpt(t, func(w http.ResponseWriter, r *http.Request) {
+		b, _ := io.ReadAll(r.Body)
+		mu.Lock()
+		path, request = r.URL.Path, b
+		mu.Unlock()
+		w.Header().Set("Content-Type", "application/json")
+		if strings.HasSuffix(r.URL.Path, "/responses/compact") {
+			io.WriteString(w, `{"id":"resp_native","output":[{"type":"compaction","encrypted_content":"opaque-native"}]}`)
+			return
+		}
+		io.WriteString(w, `{"id":"resp_summary","status":"completed","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"The earlier lookup returned azalea-42. Preserve this value."}]}]}`)
+	})
+	req := httptest.NewRequest("POST", CodexPath+"/responses/compact", strings.NewReader(`{"model":"gpt-6.1-sol","service_tier":"ultrafast","input":[{"type":"function_call","call_id":"c1","name":"lookup","arguments":"{}"},{"type":"function_call_output","call_id":"c1","output":"azalea-42"},{"type":"message","role":"user","content":[{"type":"input_text","text":"remember the lookup"}]}]}`))
+	req.Header.Set("Authorization", "Bearer header.payload.signature")
+	req.Header.Set("chatgpt-account-id", "acct-native")
+	rec := httptest.NewRecorder()
+	New().Handler().ServeHTTP(rec, req)
+	if rec.Code != 200 || !strings.HasPrefix(rec.Header().Get("Content-Type"), "application/json") {
+		t.Fatalf("native compact endpoint: %d %s", rec.Code, rec.Body.String())
+	}
+	portableOutput(t, rec.Body.String())
+	mu.Lock()
+	defer mu.Unlock()
+	if path != "/backend-api/codex/responses" || !strings.Contains(string(request), "function_call_output") || !strings.Contains(string(request), "ultrafast") {
+		t.Fatalf("summary did not preserve history and speed: %s %s", path, request)
+	}
+}
