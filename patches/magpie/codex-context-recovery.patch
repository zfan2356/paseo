@@ -0,0 +1,149 @@
+package gateway
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// A real native Codex request can carry many reasoning items from iChat.
+// Recover before publishing content, then remember the refused seals only
+// for this conversation and sign-in. Messages, calls and speed stay intact.
+func TestCodexNativeForeignReasoningRecovery(t *testing.T) {
+	for _, streamedError := range []bool{false, true} {
+		t.Run(fmt.Sprint(streamedError), func(t *testing.T) {
+			setup(t, provider.Chat, &fake{t: t})
+			var mu sync.Mutex
+			var requests []map[string]json.RawMessage
+			chatgpt(t, func(w http.ResponseWriter, r *http.Request) {
+				b, _ := io.ReadAll(r.Body)
+				var q map[string]json.RawMessage
+				if err := json.Unmarshal(b, &q); err != nil {
+					t.Error(err)
+					w.WriteHeader(500)
+					return
+				}
+				mu.Lock()
+				requests = append(requests, q)
+				mu.Unlock()
+				var items []struct {
+					Type string `json:"type"`
+					ID   string `json:"id"`
+					Enc  string `json:"encrypted_content"`
+				}
+				json.Unmarshal(q["input"], &items)
+				for _, item := range items {
+					if item.Type != "reasoning" || !strings.HasPrefix(item.Enc, "ichat-") {
+						continue
+					}
+					failure := fmt.Sprintf(`{"code":"invalid_encrypted_content","message":"The encrypted content for item %s could not be verified. Reason: Encrypted content could not be decrypted or parsed."}`, item.ID)
+					if streamedError {
+						w.Header().Set("Content-Type", "text/event-stream")
+						io.WriteString(w, sse(`data: {"type":"response.created","response":{"id":"rejected"}}`, `data: {"type":"response.failed","response":{"id":"rejected","error":`+failure+`}}`))
+					} else {
+						w.Header().Set("Content-Type", "application/json")
+						w.WriteHeader(400)
+						io.WriteString(w, `{"error":`+failure+`}`)
+					}
+					return
+				}
+				w.Header().Set("Content-Type", "text/event-stream")
+				io.WriteString(w, sse(`data: {"type":"response.output_text.delta","delta":"continued"}`, `data: {"type":"response.completed","response":{"id":"accepted","usage":{"input_tokens":7,"output_tokens":1}}}`))
+			})
+			server := New()
+			var history []string
+			for i := range 8 {
+				history = append(history, fmt.Sprintf(`{"type":"reasoning","id":"rs_%d","summary":[],"encrypted_content":"ichat-%d"}`, i, i))
+			}
+			public := `{"type":"message","role":"user","content":[{"type":"input_text","text":"Remember azalea-42"}]},{"type":"function_call","call_id":"c1","name":"lookup","arguments":"{}"},{"type":"function_call_output","call_id":"c1","output":"azalea-42"}`
+			turn := func(session, account, suffix string) {
+				t.Helper()
+				body := `{"model":"gpt-6.1-sol","stream":true,"service_tier":"ultrafast","input":[` + strings.Join(history, ",") + "," + public + suffix + `]}`
+				req := httptest.NewRequest("POST", CodexPath+"/responses", strings.NewReader(body))
+				req.Header.Set("Authorization", "Bearer test-"+account)
+				req.Header.Set("chatgpt-account-id", account)
+				req.Header.Set("session_id", session)
+				rec := httptest.NewRecorder()
+				server.Handler().ServeHTTP(rec, req)
+				if rec.Code != 200 || !strings.Contains(rec.Body.String(), "continued") || strings.Contains(rec.Body.String(), "invalid_encrypted_content") || strings.Contains(rec.Body.String(), "rejected") {
+					t.Fatalf("conversation did not continue: %d %s", rec.Code, rec.Body.String())
+				}
+			}
+			count := func() int { mu.Lock(); defer mu.Unlock(); return len(requests) }
+			turn("switch-session", "account-1", "")
+			if got := count(); got != 2 {
+				t.Fatalf("recover all foreign reasoning in one retry: got %d requests", got)
+			}
+			turn("switch-session", "account-1", `,{"type":"reasoning","id":"rs_own","summary":[],"encrypted_content":"native-own"}`)
+			if got := count(); got != 3 {
+				t.Fatalf("later turn replayed refused reasoning: got %d requests", got)
+			}
+			mu.Lock()
+			last, _ := json.Marshal(requests[2])
+			mu.Unlock()
+			if strings.Contains(string(last), "ichat-") || !strings.Contains(string(last), "native-own") || !strings.Contains(string(last), "azalea-42") || !strings.Contains(string(last), "function_call_output") || !strings.Contains(string(last), "ultrafast") {
+				t.Fatalf("recovery altered public history, own reasoning or speed: %s", last)
+			}
+			turn("other-session", "account-1", "")
+			turn("switch-session", "account-2", "")
+			if got := count(); got != 7 {
+				t.Fatalf("refused seals leaked across conversations or sign-ins: got %d requests", got)
+			}
+		})
+	}
+}
+
+func TestCodexNativeDoesNotReplayAfterOutput(t *testing.T) {
+	setup(t, provider.Chat, &fake{t: t})
+	var mu sync.Mutex
+	asks := 0
+	chatgpt(t, func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		asks++
+		mu.Unlock()
+		w.Header().Set("Content-Type", "text/event-stream")
+		io.WriteString(w, sse(`data: {"type":"response.output_text.delta","delta":"already visible"}`, `data: {"type":"response.failed","response":{"id":"failed","error":{"code":"invalid_encrypted_content","message":"The encrypted content for item rs_old could not be verified."}}}`))
+	})
+	_, body := codexPost(t, `{"model":"gpt-6.1-sol","stream":true,"input":[{"type":"reasoning","id":"rs_old","summary":[],"encrypted_content":"foreign"},{"type":"message","role":"user","content":[{"type":"input_text","text":"continue"}]}]}`)
+	mu.Lock()
+	defer mu.Unlock()
+	if asks != 1 || !strings.Contains(body, "already visible") || !strings.Contains(body, "response.failed") {
+		t.Fatalf("partially published response was replayed: asks=%d body=%s", asks, body)
+	}
+}
+
+func TestNativeRefusedReasoningConcurrentReaders(t *testing.T) {
+	key := "native-concurrent-recovery"
+	body := []byte(`{"input":[{"type":"reasoning","encrypted_content":"foreign"},{"type":"reasoning","encrypted_content":"current-own"}]}`)
+	refused(key, "native", []byte(`{"input":[{"type":"reasoning","encrypted_content":"foreign"}]}`), "reasoning")
+	start := make(chan struct{})
+	var workers sync.WaitGroup
+	workers.Add(2)
+	go func() {
+		defer workers.Done()
+		<-start
+		for range 1000 {
+			refused(key, "native", []byte(`{"input":[{"type":"reasoning","encrypted_content":"foreign"}]}`), "reasoning")
+		}
+	}()
+	go func() {
+		defer workers.Done()
+		<-start
+		for range 1000 {
+			clean, ok := withoutRefused(key, "native", body)
+			if !ok || strings.Contains(string(clean), `"foreign"`) || !strings.Contains(string(clean), "current-own") {
+				t.Error("concurrent recovery altered the current source's reasoning")
+				return
+			}
+		}
+	}()
+	close(start)
+	workers.Wait()
+}
