+			req := httptest.NewRequest("POST", CodexPath+"/responses", strings.NewReader(`{"model":"ichat/gpt-6.1-sol","stream":true,"input":[{"type":"compaction","id":"cmp_legacy","encrypted_content":"opaque-native"},{"type":"message","role":"user","content":[{"type":"input_text","text":"continue"}]}]}`))
+			req.Header.Set("Authorization", "Bearer header.payload.signature")
+			req.Header.Set("chatgpt-account-id", "acct-native")
+			rec := httptest.NewRecorder()
+			New().Handler().ServeHTTP(rec, req)
+			if rec.Code != status || nativeCalls.Load() != 1 || ichatCalls.Load() != 0 || strings.Contains(rec.Body.String(), "context was lost") {
