@@ -0,0 +1,19 @@
+package provider
+
+import "errors"
+
+// CheckQuotaOnly rejects settings that could select a fallback before quota runs out.
+func (g Group) CheckQuotaOnly() error {
+	if !g.QuotaOnly {
+		return nil
+	}
+	if g.Routing != Ordered || len(g.Members) == 0 || len(g.Match) != 0 || len(g.Rules) != 0 || g.Effort != "" || g.Sink || g.FirstToken != 0 {
+		return errors.New("quota-only requires an ordered group with explicit members and no routing rules, sink, or first-token fallback")
+	}
+	for _, id := range g.Members {
+		if IsGroupRef(id) {
+			return errors.New("quota-only groups do not accept nested groups")
+		}
+	}
+	return nil
+}
