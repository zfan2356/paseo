@@ -0,0 +1,71 @@
+package gateway
+
+import (
+	"errors"
+	"net/http"
+	"slices"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+type quotaStage struct {
+	candidates []candidate
+	order      []Weighed
+}
+
+func checkQuotaPolicy(g provider.Group, members []provider.Member) error {
+	if err := g.CheckQuotaOnly(); err != nil {
+		return err
+	}
+	for _, m := range members {
+		for _, parent := range m.Via {
+			if parent.QuotaOnly {
+				return errors.New("quota-only groups cannot be nested inside another group")
+			}
+		}
+	}
+	return nil
+}
+
+// Only the current member enters the normal retry loop. All candidates have
+// already passed account, checkpoint, image, and caller authorization filters.
+func quotaOnlyStages(g provider.Group, ms []provider.Member, cs []candidate, pl planned) ([]candidate, planned, []quotaStage, error) {
+	stages := make([]quotaStage, len(g.Members))
+	for i, id := range g.Members {
+		for _, m := range ms {
+			if m.ID != id {
+				continue
+			}
+			for j, c := range cs {
+				if c.p.ID == m.Provider.ID && c.model == m.Model && c.effort == m.Effort {
+					stages[i].candidates = append(stages[i].candidates, c)
+					stages[i].order = append(stages[i].order, pl.order[j])
+				}
+			}
+		}
+	}
+	if len(stages[0].candidates) == 0 {
+		return nil, pl, nil, errors.New("quota-only primary is unavailable or filtered; quota exhaustion has not been established, so no fallback was used")
+	}
+	pl.order = stages[0].order
+	for _, stage := range stages[1:] {
+		for _, w := range stage.order {
+			w.SkipReason = "awaiting-primary-quota"
+			pl.left = append(pl.left, w)
+		}
+	}
+	return stages[0].candidates, pl, stages[1:], nil
+}
+
+func quotaOnlyExhausted(status int, body []byte) bool {
+	return status == http.StatusTooManyRequests && failure(status, body) == failQuota
+}
+
+func activateQuotaStage(route *Route, stage quotaStage) {
+	route.Order = append(slices.Clip(route.Order), stage.order...)
+	route.Left = slices.DeleteFunc(route.Left, func(w Weighed) bool {
+		return w.SkipReason == "awaiting-primary-quota" && slices.ContainsFunc(stage.order, func(next Weighed) bool {
+			return next.ID == w.ID && next.Model == w.Model
+		})
+	})
+}
